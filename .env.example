# ============================================================
# 闲鱼智能助手 — 环境变量配置
# ============================================================
# LLM 配置（所有账号共用）
API_KEY=请通过模型平台（如百炼）获取 apikey
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max

# 单账号 Cookie（多账号请改用 accounts.yaml）
COOKIES_STR=your_cookies_here

# ============================================================
# 反风控配置（降低被检测为机器人的概率）
# ============================================================
# 模拟人工打字：自动回复前加额外延迟（每个字 0.1-0.3s）
SIMULATE_HUMAN_TYPING=False

# API 请求延迟：每次调用闲鱼接口前等待 1-3 秒（默认）
API_DELAY_MIN=1.0
API_DELAY_MAX=3.0

# 心跳抖动：在基础间隔上随机 ±10 秒（默认 15s 基础，实际 5-25s）
HEARTBEAT_INTERVAL=15
HEARTBEAT_JITTER=10
HEARTBEAT_TIMEOUT=10

# Token 刷新：默认 2 小时后刷新，加上随机 ±2 小时的抖动
TOKEN_REFRESH_INTERVAL=7200
TOKEN_REFRESH_JITTER=7200

# 风控冷却：触发风控后自动暂停 10 分钟
RISK_COOLDOWN_SECONDS=600
# 连续失败多少次触发自动冷却
MAX_CONSECUTIVE_FAILURES=5

# ============================================================
# 常规配置
# ============================================================
# 接管模式切换关键词
TOGGLE_KEYWORDS=。
# 人工接管超时（秒），默认 1 小时
MANUAL_MODE_TIMEOUT=3600
# 消息过期时间（毫秒），默认 5 分钟
MESSAGE_EXPIRE_TIME=300000
# 日志级别
LOG_LEVEL=INFO

# 自动发货
AUTO_DELIVERY=false
# 自动好评
AUTO_RATE=false
RATE_CONTENT=好买家，交易愉快

# 管理员用户 ID（逗号分隔）
ADMIN_USER_IDS=

# Web 管理界面认证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
